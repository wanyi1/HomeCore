# HomeCore Environment Configuration
APP_NAME=HomeCore
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security
SECRET_KEY=homecore-dev-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite:///./homecore.db

# Demo Simulator Mode
ENABLE_DEMO_SIMULATOR=true
